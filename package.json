{
  "name": "dsh-initiative",
  "version": "0.1.0",
  "description": "主动搭话（dsh-initiative）：没人在跟她说话时，按设定的间隔在本地掷一次骰子（不花模型），掷中了就让她在自己的会话里自己起一轮。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "initiative",
    "proactive",
    "companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8ga-tech/dsh-initiative.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./dice": "./lib/dice.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/dice.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
